# Copy to .env (git-ignored) and fill in. Nothing here is required for `npm test`;
# each block unlocks one live check. Never paste these values into chat.

# --- GitHub ------------------------------------------------------------------
# Optional: falls back to `gh auth token` when unset. Needs repo + read:org.
GITHUB_TOKEN=
# Scratch repo the live tests open PRs against (created by `npm run live:setup`).
DOCSWORTH_LIVE_GITHUB_REPO=your-org/your-scratch-repo
# Optional: a GitHub org you belong to with a team, to prove the team-ACL
# allow path and owner-only `verify` live. Leave blank to skip those checks.
DOCSWORTH_LIVE_GITHUB_ORG=
DOCSWORTH_LIVE_GITHUB_TEAM=

# --- Confluence Cloud (read-only mirror) --------------------------------------
# API token: https://id.atlassian.com/manage-profile/security/api-tokens
# Use "Create API token" (unscoped): scoped tokens need the api.atlassian.com gateway URL.
CONFLUENCE_BASE_URL=https://your-site.atlassian.net
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
# Space key to mirror in the live test, e.g. ENG
CONFLUENCE_SPACE_KEY=

# --- Notion (read-only mirror) ------------------------------------------------
# Notion → Developer tools → Connections → New connection (API token). Give it
# "Read content" only, then add the test pages under its Content access tab.
NOTION_TOKEN=
# Optional: limit the live mirror to one root page id (else: everything shared).
NOTION_ROOT_PAGE_ID=

# --- Anthropic (benchmark harness) --------------------------------------------
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5-5.
DOCSWORTH_BENCH_MODEL=

# --- Slack (owner digest) — optional, not part of the live checks --------------
SLACK_WEBHOOK_URL=
